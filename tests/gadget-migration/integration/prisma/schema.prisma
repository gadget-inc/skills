// Only the tables the Prisma snippets in references/shop-tenancy.md and references/actions-and-transactions.md
// touch. tenancy.integration.ts creates them.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("APP_DATABASE_URL")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  shopId    BigInt   @map("shop_id")
  event     String
  orderId   BigInt?  @map("order_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("audit_log")
}

model ShopifyOrder {
  id         BigInt  @id
  shopId     BigInt  @map("shop_id")
  totalPrice Decimal @map("total_price") @db.Decimal(12, 2)

  @@map("shopify_order")
}
