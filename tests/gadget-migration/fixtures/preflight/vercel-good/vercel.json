{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["iad1"],
  "schedules": {
    "prune-audit-logs": { "schedule": "0 2 * * *", "path": "/schedules/prune-audit-logs" },
    "reconcile-shops": { "schedule": "0 * * * *", "path": "/schedules/reconcile-shops", "requestMethod": "GET" },
    "prune-sessions": { "schedule": "30 3 * * *", "path": "/schedules/prune-sessions" }
  }
}
