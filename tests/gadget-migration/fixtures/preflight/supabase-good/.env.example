SHOPIFY_APP_URL=https://app.example.com
# the server's connection, through Supavisor in transaction mode
DATABASE_URL=postgres://app_server.[project-ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# migrations, through the session pooler
DIRECT_URL=postgres://postgres.[project-ref]:[password]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://[project-ref].supabase.co
